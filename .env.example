# Resend — https://resend.com (free up to 3k emails/month)
RESEND_API_KEY=re_...

# Email the quote comes FROM (must be a verified domain in Resend)
# During testing you can use: onboarding@resend.dev
FROM_EMAIL=quotes@yourdomain.com

# Where lead notifications go (your sales rep inbox — must be a real mailbox)
REP_EMAIL=you@yourcompany.com

# Optional. Where customer replies land. Defaults to REP_EMAIL.
# Needed because FROM_EMAIL is usually a send-only address with no mailbox,
# so without this a customer hitting Reply would bounce.
REPLY_TO=sales@yourcompany.com

# Optional. Customer account pricing, as one JSON object. Read server-side
# only, so codes and rates never reach the browser. Omit it entirely and
# everyone sees published pricing.
#
#   railMult/blockMult = MULTIPLIER ON AIRTAC LIST for that product line
#                          0.75 = 25% off list
#                          1.00 = at list
#                          1.80 = above list, still under the web price
#                          2.50 = the web price itself (at 150% markup)
#   partsMult          = optional per-part multipliers, which beat the line rate
#   expires            = optional ISO date, after which the code stops working
#
# Legacy `rail`, `block` and `parts` hold a PERCENTAGE OFF LIST and still work,
# so codes already issued keep their pricing. Do not rename them in place — a
# live "rail": 5 means 5% off, and reading it as 5x list would bill 5x.
#
# Margin guardrail: rails are bought at 50% of list and blocks at 32%, so a
# rail hits zero material margin at a 0.50 multiplier, a block at 0.32.
CUSTOMER_CODES={"ACME-7K2F":{"name":"Acme Automation","railMult":0.75,"blockMult":0.70,"partsMult":{"LSH20RLX4000-N-D":0.60},"expires":"2027-01-31"}}
